# Parkana settings. Every flag has a PARKANA_* variable: -storage.s3.bucket is
# PARKANA_STORAGE_S3_BUCKET. See /usr/share/doc/parkana/configuration.md.
# Read by the systemd unit. Restart Parkana after editing.

PARKANA_DATA_DIR=/var/lib/parkana
PARKANA_HTTP_ADDR=:3100
PARKANA_LOG_FORMAT=json

# Object storage: fs (under the data dir) or s3.
#PARKANA_STORAGE_BACKEND=s3
#PARKANA_STORAGE_S3_ENDPOINT=s3.example.com
#PARKANA_STORAGE_S3_BUCKET=parkana-logs
#PARKANA_STORAGE_S3_REGION=us-east-1
#PARKANA_STORAGE_S3_ACCESS_KEY=
#PARKANA_STORAGE_S3_SECRET_KEY=

# Retention (0 keeps everything) and upload freshness.
#PARKANA_COMPACTOR_RETENTION=720h
#PARKANA_INGEST_UPLOAD_MAX_AGE=1m

# Memory: the upload budget derives from the service's memory limit
# (MemoryMax= in a systemd drop-in) or GOMEMLIMIT; set either on busy hosts.
#GOMEMLIMIT=6GiB
